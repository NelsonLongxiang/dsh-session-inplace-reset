{
  "name": "@local/dsh-session-inplace-reset",
  "version": "0.3.0",
  "description": "Same-ID session reset with verified backup, per-session lifecycle release, and TypeScript decision-model handoff preview.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./preview": "./lib/register-rpc.ts",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build:client": "node tools/build-client.ts",
    "check:client": "node tools/build-client.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/client-menu.test.mjs test/decision-model.test.ts test/evaluation-settings.test.ts test/handoff-eval.test.ts test/register-rpc.test.ts test/reset.test.mjs test/session-lifecycle.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NelsonLongxiang/dsh-session-inplace-reset.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "reset"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  }
}
