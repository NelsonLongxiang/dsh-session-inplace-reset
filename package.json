{
  "name": "@local/dsh-session-inplace-reset",
  "version": "0.6.0",
  "description": "Same-ID session reset with verified backup, resumable recovery, and explicitly chosen model handoffs.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./preview": "./dist/register-rpc.js",
    "./client": "./dist/client.js",
    "./typert": "./dist/typert.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["dist", "cordis.patch.yml", "README.md", "LICENSE", "docs/design.md"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node --run build:client && node --run build:runtime",
    "build:runtime": "node tools/build-package.ts",
    "check:runtime": "node tools/build-package.ts --check",
    "build:client": "node tools/build-client.ts",
    "check:client": "node tools/build-client.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/client-menu.test.mjs test/decision-model.test.ts test/evaluation-settings.test.ts test/reset-journal.test.ts test/ledger.test.ts test/package.test.ts test/model-handoff.test.ts test/model-previews.test.ts test/handoff-eval.test.ts test/handoff-batches.test.ts test/register-rpc.test.ts test/reset.test.mjs test/session-lifecycle.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NelsonLongxiang/dsh-session-inplace-reset.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "reset"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14"
  }
}
