{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "react"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["lib/**/*.ts", "src/**/*.ts", "test/**/*.ts", "tools/**/*.ts"]
}
